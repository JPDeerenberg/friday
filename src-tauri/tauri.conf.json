{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Friday",
  "version": "2.3.8",
  "identifier": "com.joris.friday",
  "build": {
    "beforeDevCommand": "node ./scripts/pkg-run.js dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ./scripts/pkg-run.js build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Friday",
        "width": 800,
        "height": 600,
        "visible": false,
        "backgroundColor": "#030712"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://api.github.com",
        "font-src": "'self'",
        "img-src": "'self' data: https:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "host": "oauth2redirect",
          "scheme": ["m6loapp"]
        }
      ]
    }
  }
}
