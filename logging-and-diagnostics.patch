                 .level(if cfg!(debug_assertions) {
                     log::LevelFilter::Debug
                 } else {
@@ -180,6 +193,8 @@ pub fn run() {
             commands::ai_schedule::set_homework_duration,
             // Export
             commands::export::export_all_data,
+            // Diagnostics
+            commands::diagnostics::export_debug_log,
         ])
