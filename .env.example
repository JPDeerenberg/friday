# Production self-host config. Copy to `.env` and fill in:
#   cp .env.example .env

# Public domain of the site (bare domain, no scheme). Caddy provisions HTTPS.
DOMAIN=friday.example.com

# Optional: lock the API to explicit origins (comma-separated).
# Unset = permissive; safe because auth is per-request Bearer, never cookies.
#ALLOWED_ORIGINS=https://friday.example.com

# Optional: log verbosity for web-api.
#RUST_LOG=info
